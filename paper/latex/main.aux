\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Pooled HOTA on Refer-KITTI test, native host versus the shipped GMC module ($n{=}3$, mean$\pm $std). $\Delta $ is against each host's published pooled HOTA. iKUN \emph  {matches} its paper score while lifting the motion class (Table\nonbreakingspace \ref {tab:deficit}); the iKUN $\Delta $ of $+0.070$ lies within the $\pm 0.066$ seed spread and is not a beat. FlexHook (V2) is the clean pooled improvement. The \emph  {+GMC simple} control column is the simple-recipe anchor ($\alpha {=}1$, $sc{=}1$, $thr{=}0$, raw cosine, sw aligner, $n{=}3$).}}{5}{table.caption.6}\protected@file@percent }
\newlabel{tab:main}{{2}{5}{Pooled HOTA on Refer-KITTI test, native host versus the shipped GMC module ($n{=}3$, mean$\pm $std). $\Delta $ is against each host's published pooled HOTA. iKUN \emph {matches} its paper score while lifting the motion class (Table~\ref {tab:deficit}); the iKUN $\Delta $ of $+0.070$ lies within the $\pm 0.066$ seed spread and is not a beat. FlexHook (V2) is the clean pooled improvement. The \emph {+GMC simple} control column is the simple-recipe anchor ($\alpha {=}1$, $sc{=}1$, $thr{=}0$, raw cosine, sw aligner, $n{=}3$)}{table.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Motion deficit across host--split settings. Native moving-class HOTA versus the moving-class HOTA gain added by the module. The gain is monotone-inverse to native motion ability across the three settings.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:deficit}{{3}{5}{Motion deficit across host--split settings. Native moving-class HOTA versus the moving-class HOTA gain added by the module. The gain is monotone-inverse to native motion ability across the three settings}{table.caption.7}{}}
