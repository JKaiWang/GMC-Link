\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {GMC-Link pipeline.} Consecutive frames feed an ORB homography estimate; transforms compose into a cumulative homography that yields a 13D residual-velocity descriptor; a two-tower encoder aligns the descriptor with the referring expression; the alignment score corrects the host logit through additive fusion, and the result is scored by HOTA.}}{3}{figure.caption.4}\protected@file@percent }
